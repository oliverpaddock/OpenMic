	(text "design note:\nThe OPA1637's output current is limited to +/-31mA,\nso the clamping diodes at the TAC5212 inputs will\nnever see more than this. This means the series \nresistor value doesn't matter and only servers to\nisolate the circuit, not limit the current through \nthe schottky diodes."
		(exclude_from_sim no)
		(at 436.372 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
